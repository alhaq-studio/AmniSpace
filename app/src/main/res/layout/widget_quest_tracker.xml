<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/rounded_widget_bg">

    <!-- Header Row: Title & Refresh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚔️ Quest Tracker"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_coins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🪙 0"
            android:textColor="#F59E0B"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#333333" />

    <!-- Stats Row: Streak & Level -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔥 Streak: 0 days"
            android:textColor="#00F0FF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐ Lvl 1"
            android:textColor="#38BDF8"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Quests Progress Summary -->
    <TextView
        android:id="@+id/widget_quest_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quests: Tap to view &amp; complete"
        android:textColor="#CCCCCC"
        android:textSize="11sp"
        android:maxLines="2"
        android:ellipsize="end" />

</LinearLayout>
